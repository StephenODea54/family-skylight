PUBLIC_URL=https://skylight.example.com

# Built-in OAuth server (default). Generate the secret with:
#   openssl rand -base64 48
AUTH_PROVIDER=builtin
BETTER_AUTH_SECRET=
# Better Auth user ids printed by `node dist/seed-user.js <email> [name]`,
# comma-separated. Only these users may call /mcp.
ALLOWED_SUBJECTS=
# ChatGPT uses CIMD; leave DCR off unless an older MCP client needs it.
ALLOW_DCR=false

# Only for AUTH_PROVIDER=external (e.g. Auth0). JWT access tokens required.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=

# The Skylight app login. Only this server ever sees it.
SKYLIGHT_EMAIL=
SKYLIGHT_PASSWORD=
SKYLIGHT_FRAME_ID=
